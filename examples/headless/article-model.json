{
  "code": "articles",
  "display_name": "Article",
  "fields": [
    { "name": "title", "type": "string", "required": true, "validation": { "minLength": 3, "maxLength": 200 } },
    { "name": "slug", "type": "string", "required": true, "unique": true, "validation": { "match": "^[a-z0-9-]+$" } },
    { "name": "body", "type": "string" },
    { "name": "status", "type": "string", "default": "draft", "validation": { "enum": ["draft", "live", "archived"] } },
    { "name": "read_minutes", "type": "number", "validation": { "min": 1, "max": 120 } },
    { "name": "published_at", "type": "date" },
    { "name": "author", "type": "ref", "ref_model": "authors" },
    { "name": "tags", "type": "array" }
  ]
}
